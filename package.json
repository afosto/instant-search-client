{
  "name": "@afosto/instant-search-client",
  "version": "2.0.1",
  "private": false,
  "description": "The Afosto InstantSearch client",
  "keywords": [
    "client",
    "instantsearch",
    "search"
  ],
  "bugs": {
    "url": "https://github.com/afosto/instant-search-client/issues"
  },
  "license": "MIT",
  "author": "Afosto Saas BV",
  "repository": {
    "type": "git",
    "url": "https://github.com/afosto/instant-search-client.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/afosto-instant-search.min.js",
  "jsdelivr": "./dist/afosto-instant-search.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/afosto-instant-search.min.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm run typecheck:dist",
    "dev": "vite",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "tsc --noEmit -p tsconfig.dist.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@types/node": "^26.6.6",
    "algoliasearch": "^5.61.0",
    "husky": "^9.1.7",
    "instantsearch.js": "^4.122.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1"
}
